{
  "name": "shortforge",
  "productName": "ShortForge",
  "version": "1.4.0",
  "description": "Windows video editor for scene coverage and gameplay highlights with local CLI and MCP automation.",
  "main": "src/main/main.js",
  "author": "ShortForge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@deno/win32-x64": "2.9.6",
    "nodejs-whisper": "0.4.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shortforge.app",
    "productName": "ShortForge",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**",
      "**/node_modules/@deno/win32-x64/**",
      "**/node_modules/nodejs-whisper/**"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
